{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "default": "ghcr.io/romm-streaming/romm-webstation"
        },
        "tag": {
          "type": "string",
          "default": "v0.15.1",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository",
        "tag"
      ]
    },
    "broker": {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "default": "BROKER_SECRET"
        }
      }
    },
    "env": {
      "type": "object",
      "properties": {
        "PUID": {
          "type": "string",
          "default": "1000"
        },
        "PGID": {
          "type": "string",
          "default": "1000"
        },
        "TZ": {
          "type": "string",
          "default": "Etc/UTC"
        },
        "SUBFOLDER": {
          "type": "string",
          "default": "/streaming/",
          "pattern": "^/.*"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Container env vars. Extra keys (DRINODE, ROM_ROOT, EDEN_LEGACY, SELKIES_*, ...) are passed through as-is."
    },
    "extraEnv": {
      "type": "array"
    },
    "envFrom": {
      "type": "array"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpPort": {
          "type": "integer"
        },
        "httpsPort": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "pvc",
                "hostPath",
                "emptyDir"
              ]
            },
            "hostPath": {
              "type": "string"
            },
            "accessMode": {
              "type": "string",
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany",
                "ReadOnlyMany",
                "ReadWriteOncePod"
              ],
              "default": "ReadWriteOnce"
            },
            "size": {
              "type": "string",
              "default": "20Gi"
            },
            "annotations": {
              "type": "object"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "library": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "pvc",
                "hostPath",
                "emptyDir"
              ]
            },
            "hostPath": {
              "type": "string"
            },
            "accessMode": {
              "type": "string",
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany",
                "ReadOnlyMany",
                "ReadWriteOncePod"
              ],
              "default": "ReadWriteMany"
            },
            "size": {
              "type": "string",
              "default": "100Gi"
            },
            "annotations": {
              "type": "object"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            },
            "readOnly": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "shmSize": {
      "type": "string"
    },
    "gpu": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "vendor": {
          "type": "string",
          "enum": [
            "intel-amd",
            "nvidia"
          ]
        },
        "devicePath": {
          "type": "string"
        },
        "supplementalGroups": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "nvidia": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "driverCapabilities": {
              "type": "string"
            }
          }
        }
      }
    },
    "seccompUnconfined": {
      "type": "boolean"
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}